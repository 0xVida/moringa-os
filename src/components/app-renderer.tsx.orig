import React, { useState, useEffect } from "react";
import * as Icons from "lucide-react";
import { cn } from "@/lib/utils";

// --- Types ---
export type AppBlockType = "header" | "stat" | "list" | "button" | "progress" | "text-input" | "container";

export interface BaseBlock {
  type: AppBlockType;
  id?: string;
  className?: string;
}

export interface HeaderBlock extends BaseBlock {
  type: "header";
  title: string;
  subtitle?: string;
  icon?: string;
}

export interface StatBlock extends BaseBlock {
  type: "stat";
  label: string;
  value: string;
  trend?: string;
}

export interface ListBlock extends BaseBlock {
  type: "list";
  items: Array<{ label: string; checked?: boolean; sublabel?: string }>;
  selectable?: boolean;
  bind?: string; // state key for selected indices
}

export interface ButtonBlock extends BaseBlock {
  type: "button";
  label: string;
  action?: "SET_STATE" | "ALERT" | "LINK" | "NONE";
  actionKey?: string;
  actionValue?: string;
  variant?: "primary" | "ghost";
}

export interface ProgressBlock extends BaseBlock {
  type: "progress";
  label: string;
  value: number | string; // 0-100 or expression
}

export interface TextInputBlock extends BaseBlock {
  type: "text-input";
  label?: string;
  placeholder?: string;
  bind?: string;
}

export interface ContainerBlock extends BaseBlock {
  type: "container";
  blocks: AppBlock[];
}

export type AppBlock = HeaderBlock | StatBlock | ListBlock | ButtonBlock | ProgressBlock | TextInputBlock | ContainerBlock;

export interface AppConfig {
  appName: string;
  themeColor?: string;
  state?: Record<string, any>;
  blocks: AppBlock[];
}

// --- Dynamic Icon ---
function DynamicIcon({ name, className }: { name?: string; className?: string }) {
  if (!name) return null;
  const normalizedName = name.charAt(0).toUpperCase() + name.slice(1).replace(/-./g, x => x[1].toUpperCase());
  const IconComponent = (Icons as any)[normalizedName];
  if (!IconComponent) return null;
  return <IconComponent className={className} />;
}

// --- Evaluator ---
function evaluateExpression(expr: string, state: Record<string, any>) {
  try {
    const keys = Object.keys(state);
    const values = Object.values(state);
    const fn = new Function(...keys, `return ${expr}`);
    return fn(...values);
  } catch (e) {
    return undefined;
  }
}

function interpolateText(text: string | undefined, state: Record<string, any>): string {
  if (!text) return "";
  if (typeof text !== "string") return String(text);
  return text.replace(/\{([^}]+)\}/g, (match, expr) => {
    const res = evaluateExpression(expr, state);
    return res !== undefined ? String(res) : match;
  });
}

// --- Main Renderer ---

export function AppRenderer({ config }: { config: AppConfig }) {
  const themeColor = config.themeColor || "#c9ff00";
  const [appState, setAppState] = useState<Record<string, any>>(config.state || {});

  useEffect(() => {
    setAppState(config.state || {});
  }, [config]);

  const handleAction = (block: ButtonBlock) => {
    if (block.action === "SET_STATE" && block.actionKey && block.actionValue) {
      const val = evaluateExpression(block.actionValue, appState);
      setAppState(prev => ({ ...prev, [block.actionKey!]: val }));
    } else if (block.action === "ALERT" && block.actionValue) {
      alert(interpolateText(block.actionValue, appState));
    } else if (block.action === "LINK" && block.actionValue) {
      window.open(interpolateText(block.actionValue, appState), "_blank");
    }
  };

  const renderBlock = (block: AppBlock, i: number) => {
    switch (block.type) {
      case "container":
        return (
          <div key={i} className={cn(block.className)}>
            {block.blocks.map((child, j) => renderBlock(child, Number(`${i}${j}`)))}
          </div>
        );
      case "header":
        return (
          <div key={i} className={cn("flex items-center gap-4 mb-6", block.className)}>
            {block.icon && (
              <div 
                className="size-12 rounded-2xl flex items-center justify-center shrink-0"
                style={{ backgroundColor: `${themeColor}20`, color: themeColor }}
              >
                <DynamicIcon name={block.icon} className="size-6" />
              </div>
            )}
            <div>
              <h2 className="text-2xl font-display leading-tight">{interpolateText(block.title, appState)}</h2>
              {block.subtitle && <p className="text-sm text-zinc-400 mt-0.5">{interpolateText(block.subtitle, appState)}</p>}
            </div>
          </div>
        );
      case "stat":
        return (
          <div key={i} className={cn("bg-zinc-900/60 border border-white/5 rounded-2xl p-5 flex flex-col justify-center", block.className)}>
            <div className="flex items-center justify-between mb-2">
              <span className="font-mono text-[10px] uppercase tracking-widest text-zinc-500">{interpolateText(block.label, appState)}</span>
              {block.trend && (
                <span className="text-[10px] uppercase font-bold" style={{ color: block.trend.startsWith("-") ? "#f87171" : themeColor }}>
                  {interpolateText(block.trend, appState)}
                </span>
              )}
            </div>
            <div className="text-4xl font-mono tracking-tight" style={{ color: themeColor }}>
              {interpolateText(block.value, appState)}
            </div>
          </div>
        );
      case "list":
        return (
          <div key={i} className={cn("bg-zinc-900/60 border border-white/5 rounded-2xl overflow-hidden divide-y divide-white/5", block.className)}>
            {block.items.map((item, idx) => {
              // If bind exists, check if idx is in the bound array
              const boundArray = block.bind ? (appState[block.bind] || []) : [];
              const isChecked = block.bind ? boundArray.includes(idx) : item.checked;
              
              return (
                <div 
                  key={idx} 
                  className={cn("p-4 flex items-center gap-3", block.selectable && block.bind && "cursor-pointer")}
                  onClick={() => {
                    if (block.selectable && block.bind) {
                      setAppState(prev => {
                        const current = prev[block.bind!] || [];
                        const next = current.includes(idx) ? current.filter((x: number) => x !== idx) : [...current, idx];
                        return { ...prev, [block.bind!]: next };
                      });
                    }
                  }}
                >
                  {block.selectable && (
                    <div 
                      className={cn("size-5 rounded-md border flex items-center justify-center transition-colors")}
                      style={{
                        borderColor: isChecked ? themeColor : "#3f3f46",
                        backgroundColor: isChecked ? themeColor : "transparent",
                        color: isChecked ? "#000" : "transparent"
                      }}
                    >
                      <Icons.Check className="size-3.5" />
                    </div>
                  )}
                  <div className="flex-1 min-w-0">
                    <p className={cn("text-sm", isChecked ? "text-zinc-400 line-through" : "text-white")}>
                      {interpolateText(item.label, appState)}
                    </p>
                    {item.sublabel && <p className="text-xs text-zinc-500 truncate">{interpolateText(item.sublabel, appState)}</p>}
                  </div>
                </div>
              );
            })}
          </div>
        );
      case "button":
        const isPrimary = block.variant !== "ghost";
        return (
          <button 
            key={i}
            className={cn(
              "rounded-xl py-3.5 px-4 font-mono text-xs uppercase tracking-widest transition-all active:scale-[0.98]",
              isPrimary ? "text-black hover:opacity-90 font-bold" : "border border-zinc-800 text-zinc-300 hover:border-zinc-600 bg-transparent",
              block.className
            )}
            style={isPrimary ? { backgroundColor: themeColor } : {}}
            onClick={() => handleAction(block)}
          >
            {interpolateText(block.label, appState)}
          </button>
        );
      case "progress":
        let val = block.value;
        if (typeof val === "string") {
          const evalRes = evaluateExpression(val, appState);
          val = typeof evalRes === "number" ? evalRes : 0;
        }
        const progress = Math.max(0, Math.min(100, val as number));
        return (
          <div key={i} className={cn("bg-zinc-900/60 border border-white/5 rounded-2xl p-5", block.className)}>
            <div className="flex items-center justify-between mb-3">
              <span className="font-mono text-[10px] uppercase tracking-widest text-zinc-400">{interpolateText(block.label, appState)}</span>
              <span className="font-mono text-[10px] text-white">{progress.toFixed(0)}%</span>
            </div>
            <div className="h-2 w-full bg-black rounded-full overflow-hidden">
              <div 
                className="h-full rounded-full transition-all duration-1000 ease-out" 
                style={{ width: `${progress}%`, backgroundColor: themeColor }} 
              />
            </div>
          </div>
        );
      case "text-input":
        return (
          <div key={i} className={cn("space-y-1.5", block.className)}>
            {block.label && <label className="font-mono text-[10px] uppercase tracking-widest text-zinc-500 pl-1">{interpolateText(block.label, appState)}</label>}
            <input 
              type="text" 
              placeholder={interpolateText(block.placeholder, appState)}
              value={block.bind ? (appState[block.bind] || "") : ""}
              onChange={(e) => {
                if (block.bind) {
                  setAppState(prev => ({ ...prev, [block.bind!]: e.target.value }));
                }
              }}
              className="w-full bg-black border border-zinc-800 rounded-xl px-4 py-3 text-sm text-white placeholder:text-zinc-600 focus:outline-none focus:border-zinc-600 transition-colors"
            />
          </div>
        );
      default:
        return null;
    }
  };

  return (
    <div className="w-full max-w-md mx-auto flex flex-col gap-4 animate-in fade-in slide-in-from-bottom-4 duration-500">
      {config.blocks.map((block, i) => renderBlock(block, i))}
    </div>
  );
}
